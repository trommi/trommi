# Trommi hub as a systemd user service.
#
# This file is a template: deploy/install-user-service.sh replaces the three
# @PLACEHOLDERS@ and writes the result to ~/.config/systemd/user/. Do not copy
# it by hand without replacing them.
#
#   @TROMMI_DIR@  absolute path of the checkout
#   @NODE@        absolute path of a node binary (22 or newer) that runs without a login shell
#   @DATA_DIR@    absolute path of the data directory (state, attachments, token)
#
# The whole picture is in docs/operations.md.

[Unit]
Description=Trommi hub (board for Claude Code sessions)
Documentation=file://@TROMMI_DIR@/docs/operations.md
# Give up after five failed starts in a minute instead of spinning forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@TROMMI_DIR@

# BOARD_HUB_ONLY=1 is what makes this a service: the process serves as hub
# without being an agent session, does not read stdin (so it does not exit
# when stdin is /dev/null), and waits for the port instead of linking to
# whoever holds it. These two are set here and not in hub.env, because the
# sandbox below depends on the data path. Do not repeat them in hub.env:
# an EnvironmentFile wins over Environment=.
Environment=BOARD_HUB_ONLY=1
Environment=BOARD_DATA=@DATA_DIR@
# Port, bind address, public URL, speech key. Optional ("-"): defaults apply without it.
EnvironmentFile=-%E/trommi/hub.env

# A server.mjs from before BOARD_HUB_ONLY would see end-of-file on stdin and
# exit with status 0 at once. Fail loudly instead.
ExecStartPre=/usr/bin/grep -q BOARD_HUB_ONLY @TROMMI_DIR@/server/server.mjs
ExecStart=@NODE@ @TROMMI_DIR@/server/server.mjs

# on-failure, not always: `systemctl --user stop` and a clean exit stay stopped.
# The state file is written whole on every change, so SIGTERM needs no handler.
Restart=on-failure
# Short on purpose: while the port is free, a linked agent session tries to take
# it over after 150 to 650 ms. Measured with a 1 s pause the session won and the
# service was left waiting; with an immediate restart the service won.
RestartSec=100ms
TimeoutStopSec=10

StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trommi-hub

# ---- sandbox ---------------------------------------------------------------
# In a user unit the mount-namespace options below work through an implicit
# user namespace (PrivateUsers=yes). They need unprivileged user namespaces,
# which Arch has switched on.
NoNewPrivileges=yes
UMask=0077

# Everything is read-only except the data directory.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DATA_DIR@
# Agents attach files by absolute path and the hub copies them, so the hub must
# be able to read the home directory and the real /tmp: no PrivateTmp, no
# ProtectHome=yes. What an attachment must never be is hidden instead.
PrivateTmp=no
InaccessiblePaths=-%h/.ssh -%h/.gnupg -%h/.aws -%h/.1password -%h/.password-store -%E/trommi

PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# AF_NETLINK: node lists the network interfaces to write the LAN link into url.txt.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
# Not set: MemoryDenyWriteExecute. V8 compiles to memory it then executes.

[Install]
WantedBy=default.target
