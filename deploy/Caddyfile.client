# The static web client from an origin of its own, apart from the hub.
#
#   TROMMI_DIR=/home/you/git/trommi caddy run --config deploy/Caddyfile.client --adapter caddyfile
#   deploy/tailscale-serve.sh --client 8792        # https://MACHINE.TAILNET.ts.net:8444/
#
# Caddy listens on loopback and speaks plain HTTP; `tailscale serve` puts HTTPS
# with the tailnet certificate in front, as it does for the hub.
#
# This is a preparation, not something to switch on today: the client still
# calls the hub with relative addresses and a cookie, so a page loaded from
# here finds no hub. What the client and the hub need first is in
# docs/operations.md, "The web client from its own origin". Not tested: caddy
# is not installed on the machine this was written on.
{
	auto_https off
	admin off
}

http://127.0.0.1:8792 {
	root * {$TROMMI_DIR}/client/web

	# The page keeps its place in the address (/s/<session>, /inbox, /agents):
	# those paths are the page too, as in server.mjs (APP_PATH).
	@app path_regexp ^/(s/.*|agents|inbox)?$
	rewrite @app /index.html

	@static path /css/* /js/* /*.html
	handle @static {
		file_server
	}
	handle {
		respond "not found" 404
	}

	header {
		# TROMMI_HUB_ORIGIN (e.g. https://MACHINE.TAILNET.ts.net) is the one address
		# the page may talk to. Before this policy holds, two things in index.html
		# must change: the fonts come from Google today, and it has inline scripts.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: blob: {$TROMMI_HUB_ORIGIN}; media-src blob: {$TROMMI_HUB_ORIGIN}; connect-src {$TROMMI_HUB_ORIGIN}; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cache-Control no-cache
		-Server
	}
}
