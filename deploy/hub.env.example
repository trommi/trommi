# Environment of the Trommi hub service. Installed once as ~/.config/trommi/hub.env
# (mode 0600) and never overwritten. Format: KEY=value, one per line, no quotes
# needed, no shell expansion. After a change: systemctl --user restart trommi-hub
#
# Not here: BOARD_HUB_ONLY and BOARD_DATA. The unit sets both, and the unit's
# sandbox must name the same data directory. To move the data directory, run
# deploy/install-user-service.sh --data DIR again.

# The port the hub listens on. Agent sessions find the hub on this port on
# loopback, so they need the same BOARD_PORT in their environment if it is not 8790.
BOARD_PORT=8790

# 127.0.0.1: reachable only from this machine and, through `tailscale serve`,
# from the tailnet over HTTPS. 0.0.0.0 would also offer plain HTTP to the LAN.
BOARD_HOST=127.0.0.1

# The HTTPS name from `tailscale serve`, so the login link in data/url.txt and
# on the admin page is the one a phone can open. deploy/tailscale-serve.sh prints it.
#BOARD_PUBLIC_URL=https://MACHINE.TAILNET.ts.net

# Speech (dictation, read aloud, create_voiceover). Alternatively a file
# tinfoil.key in the data directory. Without either the buttons are absent.
#TINFOIL_API_KEY=

# Leave the access token and the admin key to the files in the data directory
# (token, admin-token) unless there is a reason. A token pinned here cannot be
# rotated from the admin page, and every agent session then needs the same
# BOARD_TOKEN in its environment.
#BOARD_TOKEN=
#BOARD_ADMIN_TOKEN=

# Answered cards and their attachments are deleted after this many days.
#BOARD_RETENTION_DAYS=30
#BOARD_MAX_ATTACHMENT_MB=1024
