# Cloudflare static assets headers (also read by dev/serve.mjs). Strict CSP: scripts, styles, fonts only from this
# origin; data only to the hub. Style attributes are allowed (the views set --hue etc. per element).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-9xvXDCjvw7LwmLUiQWHPJbFHCwbhGsXzaZRDBYWBfS8=' 'sha256-TTiI2F4imaAUorT3Pm4tRJeyZVfUw8qlcK7efdyaCok='; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://hub.trommi.com; frame-src 'self' blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), geolocation=(), microphone=(self)
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
# The stylesheet bundle and the app's modules (dev/build.mjs): their names change with their content.
/gen/bundle.*
  Cache-Control: public, max-age=31536000, immutable
/gen/app/*
  Cache-Control: public, max-age=31536000, immutable
# The sandboxed viewer for published pages (scripts of an agent's page run here, never in the app's origin).
# (Cloudflare answers /frame.html with a redirect to /frame: the rule must name both.)
/frame
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; media-src data: blob:; font-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; sandbox allow-scripts
/frame.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; media-src data: blob:; font-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; sandbox allow-scripts
# The connector for Claude Code (connector/build.mjs, built at deploy time) and its checksum: always the newest (the connect script fetches both,
# at /connector.mjs and /connector.mjs.sha256: worker.js assetPath).
/gen/connector.mjs
  Cache-Control: no-cache
/gen/connector.mjs.sha256
  Cache-Control: no-cache
  Content-Type: text/plain; charset=utf-8
# The Trommi plugin's marketplace for Claude Code (connector/build.mjs): the listing always the newest; the archives
# are named by version. Public address /plugins/… (worker.js assetPath).
/gen/plugins/marketplace.json
  Cache-Control: no-cache
  Content-Type: application/json; charset=utf-8
/gen/plugins/*.zip
  Cache-Control: public, max-age=31536000, immutable
