{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trommi-app",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // The build step (dev/build.mjs): everything in public/gen/, sw.js and the preloads; it runs npm ci at the repository
  // root first. It installs and writes only in Cloudflare's build (WORKERS_CI=1).
  "build": { "command": "node dev/build.mjs" },
  // The app is static: every navigation that is not a file gets index.html (the app routes in the page).
  // The worker runs first: http to https, the universal links' file, /favicon.ico.
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true }
}
