  "email": {
    "rule": "1. drop leading and trailing U+0020 and U+0009..U+000D. 2. every character left is U+0021..U+007E, else bad-email (nothing is mapped or normalised). 3. A-Z become a-z. 4. at most 254 characters; exactly one \"@\"; 1 to 64 characters before it; after it a \".\" with 1 to 190 characters before and 2 to 63 after.",
    "cases": [
      {
        "input": "owner@example.com",
        "normalised": "owner@example.com",
        "why": "as it is"
      },
      {
        "input": "  Owner@Example.COM ",
        "normalised": "owner@example.com",
        "why": "capitals, spaces around it"
      },
      {
        "input": "\t\r\n\u000b\fAda.Lovelace+Notes@Sub.Example.ORG\n",
        "normalised": "ada.lovelace+notes@sub.example.org",
        "why": "every dropped character around it; dots and a plus kept"
      },
      {
        "input": "O'Brien_{x}|~!#$%&*/=?^`@example.org",
        "normalised": "o'brien_{x}|~!#$%&*/=?^`@example.org",
        "why": "printable ASCII in the local part is kept as it is"
      },
      {
        "input": "user@xn--mller-kva.example.org",
        "normalised": "user@xn--mller-kva.example.org",
        "why": "a domain in punycode"
      },
      {
        "input": "a@example..com",
        "normalised": "a@example..com",
        "why": "two dots: the rule asks for one dot with enough on both sides"
      },
      {
        "input": "a@example.com.",
        "normalised": "a@example.com.",
        "why": "a dot at the end: the dot before \"com.\" counts"
      },
      {
        "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@example.org",
        "normalised": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@example.org",
        "why": "64 characters before the @"
      },
      {
        "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com",
        "normalised": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com",
        "why": "254 characters"
      },
      {
        "input": "x@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com",
        "normalised": "x@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com",
        "why": "190 characters before the first dot"
      },
      {
        "input": "x@a.777777777777777777777777777777777777777777777777777777777777777",
        "normalised": "x@a.777777777777777777777777777777777777777777777777777777777777777",
        "why": "63 characters after the dot"
      },
      {
        "input": "A@B.CD",
        "normalised": "a@b.cd",
        "why": "the shortest"
      },
      {
        "input": "",
        "error": "bad-email",
        "why": "empty"
      },
      {
        "input": "   ",
        "error": "bad-email",
        "why": "only spaces"
      },
      {
        "input": "owner",
        "error": "bad-email",
        "why": "no @"
      },
      {
        "input": "owner@example",
        "error": "bad-email",
        "why": "no dot after the @"
      },
      {
        "input": "@example.com",
        "error": "bad-email",
        "why": "nothing before the @"
      },
      {
        "input": "owner@@example.com",
        "error": "bad-email",
        "why": "two @"
      },
      {
        "input": "a@b@example.com",
        "error": "bad-email",
        "why": "two @"
      },
      {
        "input": "owner@.com",
        "error": "bad-email",
        "why": "nothing before the dot"
      },
      {
        "input": "owner@example.c",
        "error": "bad-email",
        "why": "one character after the dot"
      },
      {
        "input": "own er@example.com",
        "error": "bad-email",
        "why": "a space inside"
      },
      {
        "input": "owner@exam\tple.com",
        "error": "bad-email",
        "why": "a tab inside"
      },
      {
        "input": "owner@example.com\u0000",
        "error": "bad-email",
        "why": "a control character"
      },
      {
        "input": "owner@example.com",
        "error": "bad-email",
        "why": "DEL"
      },
      {
        "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@example.org",
        "error": "bad-email",
        "why": "65 characters before the @"
      },
      {
        "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com",
        "error": "bad-email",
        "why": "255 characters"
      },
      {
        "input": "x@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com",
        "error": "bad-email",
        "why": "191 characters and more before every dot"
      },
      {
        "input": "x@a.7777777777777777777777777777777777777777777777777777777777777777",
        "error": "bad-email",
        "why": "64 characters after the dot"
      },
      {
        "input": "m\u00fcller@example.com",
        "error": "bad-email",
        "why": "a letter outside ASCII (composed)"
      },
      {
        "input": "mu\u0308ller@example.com",
        "error": "bad-email",
        "why": "the same letter decomposed"
      },
      {
        "input": "user@m\u00fcller.example.org",
        "error": "bad-email",
        "why": "a domain outside ASCII: write it as punycode"
      },
      {
        "input": "\u00a0owner@example.com",
        "error": "bad-email",
        "why": "a no-break space is not dropped"
      },
      {
        "input": "owner@example.com\ufeff",
        "error": "bad-email",
        "why": "a byte order mark is not dropped"
      },
      {
        "input": "owner@example.com\u2028",
        "error": "bad-email",
        "why": "a line separator is not dropped"
      },
      {
        "input": "owner\uff20example.com",
        "error": "bad-email",
        "why": "a fullwidth @"
      },
      {
        "input": "\u0130stanbul@example.com",
        "error": "bad-email",
        "why": "a capital outside ASCII is not lowercased"
      },
      {
        "input": "owner@example.com\ud83d\ude00",
        "error": "bad-email",
        "why": "an emoji"
      },
      {
        "input": "owner@example\u3002com",
        "error": "bad-email",
        "why": "an ideographic full stop is no dot"
      }
    ]
