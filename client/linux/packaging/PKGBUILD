# Sketch, not yet built with makepkg. Builds from a checkout of the
# repository (trommi has no releases yet); for the AUR, source= would
# name a tag instead.
pkgname=trommi-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Answer the questions of your coding agents: a native window for a Trommi board"
arch=('x86_64' 'aarch64')
url="https://github.com/chriopter/trommi"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'libsecret')
optdepends=('qt6-wayland: run as a Wayland client (Hyprland, Sway, GNOME)'
            'gnome-keyring: a Secret Service to keep the board link in'
            'mako: desktop notifications on Hyprland')
makedepends=('git')
provides=('trommi')
conflicts=('trommi')
source=("trommi::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd trommi
  printf "0.1.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  mkdir -p build && cd build
  qmake6 ../trommi/client/linux/app/app.pro PREFIX=/usr
  make
}

check() {
  mkdir -p check && cd check
  qmake6 ../trommi/client/linux/tests/core/core.pro
  make
  ./tst_core
}

package() {
  cd build
  make INSTALL_ROOT="$pkgdir" install
}
