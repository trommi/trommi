#!/usr/bin/env bash
# Screenshot the window off screen, apart from any real board (the idea
# and the environment come from brumm's bin/gui-shot):
#   bin/shot out.png ["KEYS"] [WxH]
# KEYS are pressed first, by name and separated by spaces ("j j enter",
# "tab c type:Hallo_du enter"). The window shows the demo state in
# tests/fixtures/, or the board in TROMMI_LINK if that is set.
# TROMMI_THEME=dark|light picks the look, SHOT_MS (1500) when the picture
# is taken, SHOT_BACKEND=software draws without a GPU.
set -euo pipefail
cd "$(dirname "$0")/.."

out=$(realpath -m "$1")
build=${TROMMI_BUILD:-build}
bin/build >/dev/null
run=$(mktemp -d)
trap 'rm -rf "$run"' EXIT
args=(--demo "${SHOT_STATE:-tests/fixtures/board-state.json}")
[[ -n ${TROMMI_LINK:-} ]] && args=("$TROMMI_LINK")
backend=(QT_QUICK_BACKEND=rhi QSG_RHI_BACKEND=opengl)
[[ ${SHOT_BACKEND:-} == software ]] && backend=(QT_QUICK_BACKEND=software)
# The keyring and the kept link are left alone: its own config directory,
# and the file instead of the Secret Service.
env -u QT_QPA_PLATFORMTHEME QT_QPA_PLATFORM=offscreen QT_FORCE_STDERR_LOGGING=1 "${backend[@]}" \
  XDG_RUNTIME_DIR="$run" XDG_CACHE_HOME="$run/cache" XDG_CONFIG_HOME="$run/config" TROMMI_NO_KEYRING=1 \
  TROMMI_SHOT="$out" TROMMI_KEYS="${2:-}" TROMMI_SIZE="${3:-}" TROMMI_SHOT_MS="${SHOT_MS:-1500}" \
  "$build/app/trommi" "${args[@]}"
