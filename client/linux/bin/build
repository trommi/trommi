#!/usr/bin/env bash
# Build the window, trommi (a Qt 6 Quick program in app/), into build/.
# Needs qt6-base, qt6-declarative and a C++ compiler (base-devel);
# libsecret for the keyring, else the link goes into a 0600 file.
set -euo pipefail
cd "$(dirname "$0")/.."

command -v qmake6 >/dev/null || { echo "trommi needs Qt 6: sudo pacman -S qt6-base qt6-declarative" >&2; exit 1; }
build=${TROMMI_BUILD:-build}
mkdir -p "$build/app"
root=$PWD
(cd "$build/app" && qmake6 "$root/app/app.pro" "$@" >/dev/null && make -s -j"$(nproc)")
echo "$build/app/trommi"
