# The hub under systemd. Installed once by hub/deploy/install.sh and NOT part of a release: a release brings the
# program this unit runs (/srv/trommi/deploy/current is a link the updater swaps), never the rules it runs under.
# So whatever a release contains runs as the user `trommi` inside the limits below, and nothing a release or the
# updater does can make it root. Changing this file means running install.sh again.
#
# Settings of this server are in /etc/trommi/hub.env (address, origins, switches) and /etc/trommi/hub-secrets.env
# (push credentials); where the hub listens and keeps its data is fixed here and cannot be changed from those files.
# Not started at boot by itself: the updater starts it, after it has settled a deploy that a reboot may have cut off.
[Unit]
Description=Trommi hub
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=trommi
Group=trommi
EnvironmentFile=/etc/trommi/hub.env
EnvironmentFile=-/etc/trommi/hub-secrets.env
# before another release starts for the first time: a copy of the database and the hub's keys (the hub stands still)
RuntimeDirectory=trommi-hub
RuntimeDirectoryPreserve=yes
ExecStartPre=/bin/sh /usr/local/lib/trommi/hub-prestart.sh /srv/trommi/deploy /srv/trommi/data /srv/trommi/backups /run/trommi-hub
ExecStart=/usr/bin/env HUB_HOST=127.0.0.1 HUB_PORT=8790 HUB_DATA=/srv/trommi/data /srv/trommi/deploy/current/trommi-hub
Restart=always
RestartSec=2
TimeoutStopSec=30
LimitNOFILE=65536
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/trommi/data /srv/trommi/backups
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
